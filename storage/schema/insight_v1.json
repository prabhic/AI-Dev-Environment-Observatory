{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architectural Insight Schema v1",
  "description": "Schema for repository architectural analysis insights",
  "type": "object",
  "required": ["repo_id", "analyzed_at", "version", "architecture_style", "primary_language"],
  "properties": {
    "repo_id": {
      "type": "string",
      "description": "Unique repository identifier"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of analysis"
    },
    "version": {
      "type": "string",
      "description": "Schema version",
      "const": "1.0"
    },
    "architecture_style": {
      "type": "string",
      "enum": ["extension", "cli-agent", "web-ide", "framework", "hybrid"]
    },
    "primary_language": {
      "type": "string"
    },
    "key_dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose", "file_path"],
        "properties": {
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "file_path": {"type": "string"},
          "key_patterns": {
            "type": "array",
            "items": {"type": "string"}
          },
          "complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "reusability_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "llm_integration": {
            "type": "object"
          }
        }
      }
    },
    "llm_strategy": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "streaming": {"type": "boolean"},
        "tool_calling": {"type": "boolean"},
        "context_optimization": {"type": "string"}
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "category": {"type": "string"},
          "description": {"type": "string"},
          "code_example": {"type": "string"}
        }
      }
    },
    "analysis_metadata": {
      "type": "object",
      "properties": {
        "files_analyzed": {"type": "integer"},
        "llm_calls": {"type": "integer"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "analysis_duration_seconds": {"type": "number"}
      }
    }
  }
}
